{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "SKIP_ELECTRON_REBUILD=true ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci",
  "buildCommand": "npm run build:webserver && npm run build:migrations && VITE_HOSTED_DB=true VITE_API_URL= npm run build:renderer",
  "outputDirectory": "dist-renderer",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist-migrations/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
